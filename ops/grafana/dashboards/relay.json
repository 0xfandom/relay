{
 "uid": "relay-overview",
 "title": "Relay",
 "description": "Every failure mode Relay defends against, in one view.",
 "tags": [
  "relay"
 ],
 "timezone": "browser",
 "editable": false,
 "schemaVersion": 39,
 "version": 2,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Is Relay healthy",
   "description": "Four numbers. If all four are calm, nothing below needs looking at.",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Oldest pending delivery",
   "description": "How far past its due time the oldest pending delivery is. This is the primary health signal, not depth: depth can be thousands and healthy while a burst drains, or three and catastrophic when those three have been stuck for an hour. Reads 'No data' on an empty queue, because an empty queue has no oldest item \u2014 that is deliberately not the same as zero.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 30
       },
       {
        "color": "red",
        "value": 300
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "max(relay_queue_oldest_pending_age_seconds)",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Due now",
   "description": "Pending deliveries whose time has come. The gap against total pending is work that is waiting on purpose \u2014 a backoff, a deferral \u2014 rather than work nobody is getting to.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "reduceOptions": {
