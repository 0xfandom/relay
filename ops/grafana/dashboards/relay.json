   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "max(relay_queue_due)",
     "legendFormat": "",
     "range": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
