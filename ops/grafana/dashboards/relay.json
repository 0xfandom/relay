   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Queue depth by status",
   "description": "The open set. Succeeded deliveries are never counted here \u2014 they are the overwhelming majority of the table and never part of the answer.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
