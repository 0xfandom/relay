  {
   "id": 7,
   "type": "timeseries",
   "title": "Throughput by outcome",
   "description": "Attempts per second, split the same four ways the attempt log records them. A healthy system is almost entirely `success`; a rising `deferred` share means a gate is holding work back, and the panel below says which.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 25,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "sum by (outcome) (rate(relay_delivery_attempts_total[1m]))",
     "legendFormat": "{{outcome}}",
     "range": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "row",
   "title": "Back-pressure \u2014 which gate is holding work back (M5)",
   "description": "A deferral is not a failure. Nothing was sent, so it spends no retry attempt \u2014 but it does mean deliveries are queueing, and the reason matters.",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Deferrals by reason",
   "description": "`rate_limit` \u2014 the endpoint's configured rate is the bound. `concurrency_cap` \u2014 the endpoint already has all the requests in flight it is allowed. `breaker_open` \u2014 the endpoint is cut off entirely. `probe_in_flight` \u2014 another worker is testing whether it has recovered.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 25,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "sum by (reason) (rate(relay_deliveries_deferred_total[1m]))",
     "legendFormat": "{{reason}}",
     "range": true,
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Delivery latency",
   "description": "Time spent on somebody else's server. Failures are included: a timeout is the slowest possible delivery, and excluding it would make an endpoint look fastest at the moment it stopped working. Deferrals are excluded \u2014 nothing was sent, so there is no duration.",
   "datasource": {
    "type": "prometheus",
    "uid": "relay-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true,
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(relay_delivery_duration_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_delivery_duration_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "range": true,
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "relay-prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_delivery_duration_seconds_bucket[5m])))",
     "legendFormat": "p99",
     "range": true,
     "refId": "C"
    }
   ]
